# .gitignore for Chaotic Cosmos Axiomatic System

# Obsidian
.obsidian/
.trash/
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# System files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.log
*.cache

# Backup files
*.bak
*.backup

# OS metadata
._*

# TRAE Work (if used)
.trae/
.trae-workspace/

# Local sensitive info (if any)
*.local.md
*.secret.md
.env

# Personal notes (if you keep a private folder)
private/
drafts/